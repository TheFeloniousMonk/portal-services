# Copy to .env next to docker-compose.yaml on the supplier host and fill in.
# Never commit the filled copy. Each supplier of meme-watch needs its own key:
# create one at https://console.dexpaprika.com (free tier, no card required).
MW_DEXPAPRIKA_API_KEY=

# The key's plan: "free" (the default) or "paid" (Dev, Pro or Enterprise).
# Paid keys use api-pro.dexpaprika.com; raise MW_MONTHLY_CREDITS in
# docker-compose.yaml to match the plan's allowance.
MW_DEXPAPRIKA_PLAN=free
